# PostgreSQL connection string. Use the internal URL on Render and external URL locally.
# Example: DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Generate a unique long random value for each environment.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
# Public frontend origin. Set this to the deployed frontend URL in production.
FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV="development"
COOKIE_NAME="ouou_token"
AI_PROVIDER="fallback"
# AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GROQ_API_KEY=""
N8N_WEBHOOK_URL=""
